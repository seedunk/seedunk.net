        public bool TryAdd(Dictionary<string, object> kv,   out string lastId) {
                lastId = "";
         
                List<string> columnNames = new List<string>();
                List<string> columnValues = new List<string>();
                List<string> columnValues2 = new List<string>();

                Dictionary<string, object> values = new Dictionary<string, object>();
                foreach (var property in kv)
                {
                     
                    string columnName = ColumnNameParser(property.Key);
                    if ( property.Value != null&&!columnName.Equals(Model.PrimaryPropertyName)) {
                            columnNames.Add(columnName);
                            columnValues.Add("@"+columnName); 
                            values.Add(columnName, property.Value ); 
                            columnValues2.Add("'"+Convert.ToString(property.Value) +"'");
                        }
                  
                }
                string sql = "insert into " + Model.ModelName
                                + "(" + string.Join(",", columnNames)
                                + ") values(" + string.Join(",", columnValues) + ")";

            Debug.WriteLine("insert into " + Model.ModelName
                                + "(" + string.Join(",", columnNames)
                                + ") values(" + string.Join(",", columnValues2) + ")");
                var ret =  ExecuteNonQuery(sql , values); 
                if (ret.IsSuccess && ret.Content > 0)
                {
                var idRes =  GetDataTable("select max(" + Model.PrimaryPropertyName + ") as 'LastId' from " + Model.ModelName + " LIMIT 1;");
                if (idRes.IsSuccess && idRes.Rows.Count == 1)
                {
                    lastId = Convert.ToString(idRes.Rows[0]["LastId"]);
                    return true;
                }
                else return false;
            }
            else return false;
         
        }
        public bool TryUpdate(T1 obj)
        {
            IModel model = obj as IModel; 
            Dictionary<string, object> kv = model.ToDictionary();
           
            List<string> columns = new List<string>(); 
            string primaryValue = "0";

            Dictionary<string, object> values = new Dictionary<string, object>();
             
            foreach (var property in kv)
            {
                if (!property.Key.Substring(0, 1).Equals("_"))
                { 
                    string columnName = ColumnNameParser(property.Key);
                    if (property.Value != null && Model.PrimaryPropertyName.Equals(columnName))
                    {
                        primaryValue = Convert.ToString(property.Value);
                    } 
                    else if (property.Value != null)
                    {
                    columns.Add(columnName + "=@" + columnName);
                        values.Add(columnName, property.Value);
                    }
                }
            }
            string sql = "update " + Model.ModelName  + " set "+ string.Join(",", columns)
                         + " where "+Model.PrimaryPropertyName+"= '"+ primaryValue  + "';"; 
            Debug.WriteLine("SQL Update: " + sql);

            var ret =  ExecuteNonQuery(sql, values);
            return ret.IsSuccess && ret.Content > 0;
        }

