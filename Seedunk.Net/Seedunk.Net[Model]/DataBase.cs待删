        #region 可被重载的方法
        public virtual string ColumnNameParser(string name) {
            
            return Regex.Replace(name, "([A-Z])", "_$1").ToLower().TrimStart('_');
        }
        #endregion

        
        
        public bool TryQueryRow(string sql, out Dictionary<string, object> row)
        {
            QueryResponse res =  GetDataTable(sql);
            List<T1> rows = new List<T1>();
            if (res.Rows.Count == 1)
            {
                row = ModelUtil<DataRow>.ToDictionary(res.Rows[0]);
                return true;
            }
            else
            {
                row = null;
                return false;
            }
        }
          
        public int QueryCount(Dictionary<string, object> where) {
            string whereSql = where == null ? "" : (" where " +  where.ToAndSQL());
            var res =  GetDataTable("select count(0) as 'count' from " + Model.ModelName + whereSql);
            if (res.IsSuccess && res.Rows.Count > 0)
            {
                return int.Parse(Convert.ToString(res.Rows[0]["count"]));
            }
            else return 0;
        }

       
  
        public List<T1> QueryResult(Dictionary<string, object> where, Dictionary<string, string> orderBys, int limit, int span)
        {
            string whereSql = where == null ? "" : (" where " + where.ToAndSQL());
            if (orderBys != null) {
                whereSql += orderBys.ToOrderSQL(); 
            } 
            return QueryResult("select * from " + Model.ModelName + whereSql + " limit " + limit + "," + span + ";");
        }
       
        public List<T1> QueryResult(string sql) {
            sql = sql.Replace("{TableName}", Model.ModelName);
            Debug.WriteLine("QueryResult: " + sql); 
            QueryResponse res =  GetDataTable(sql);
            List<T1> rows = new List<T1>();
            for (int i = 0; i < res.Rows.Count; i++) { 
                Dictionary<string, object> kv = ModelUtil<DataRow>.ToDictionary(res.Rows[i]);
                T1 model = (T1)Activator.CreateInstance(typeof(T1));
                ((IModel)model).BindDictionary(kv); 
                rows.Add(model); 
            }
            return rows;
        }
        
        public virtual bool TryGetByPrimaryValue(string value, out T1 row)
        {
            string sql = "select * from " + Model.ModelName + " where " + Model.PrimaryPropertyName + "='" + value + "';";
            // Debug.WriteLine("TryGetByPrimaryValue: " + sql);            
            var res =  GetDataTable(sql); 
            if (res.Rows.Count == 1)
            {
                Dictionary<string, object>  kv= ModelUtil<DataRow>.ToDictionary(res.Rows[0]); 
                T1 model = (T1)Activator.CreateInstance(typeof(T1)) ;
                        ((IModel)model).BindDictionary(kv);
                row = model;
                return true;
            }
            else {
                row = default(T1);
                return false;
            }
        }
        public virtual bool TryGetRow(Dictionary<string,object> wheres, out T1 row)
        {
            string whereSql = wheres == null ? "" : (" where " + wheres.ToAndSQL()); 
            return TryGetRow("select * from " + Model.ModelName + " " + whereSql, out row);
        }
        public virtual bool TryGetRow(string sql, out T1 row)
        {       
            var res =  GetDataTable(sql);
            if (res.Rows.Count > 0)
            {
                Dictionary<string, object> kv = ModelUtil<DataRow>.ToDictionary(res.Rows[0]);
                T1 model = (T1)Activator.CreateInstance(typeof(T1));
                ((IModel)model).BindDictionary(kv);
                row = model;
                return true;
            }
            else
            {
                row = default(T1);
                return false;
            }
        }
